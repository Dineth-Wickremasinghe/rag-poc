# Microsoft Entra application (public client) used to sign in to Microsoft Graph.
CLIENT_ID=

# OneDrive folder item id to watch. See the README for how to find it.
FOLDER_ID=

# Personal Microsoft accounts use "consumers". Work or school accounts use the tenant id.
GRAPH_AUTHORITY=https://login.microsoftonline.com/consumers

AGENT=python-agent

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=python-agent-kb
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=rag-file-events
KAFKA_GROUP_ID=rag-ingestion-consumer

DELTA_STATE_FILE=delta_state.txt
DOWNLOAD_DIR=downloads
